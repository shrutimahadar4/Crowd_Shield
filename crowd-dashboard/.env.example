# ──────────────────────────────────────────────────
# CrowdShield — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control!
# ──────────────────────────────────────────────────

# Twilio credentials for emergency SMS alerts
# Get these at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Destination phone number for emergency alerts (E.164 format)
TWILIO_DEST_PHONE=+1XXXXXXXXXX

# Optional: CAP Alert webhook endpoint (leave blank for local-only mode)
# CAP_DISPATCH_ENDPOINT=http://your-server/api/cap-alerts
